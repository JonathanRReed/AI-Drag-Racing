{
  "name": "ai-comparator",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "bun run build:theme && bun scripts/verify-react-runtime.mjs && next build --webpack",
    "build:theme": "bun build scripts/site-theme.source.js --target browser --format iife --minify --outfile public/site-theme.js",
    "start": "next start",
    "lint": "eslint . --ext .js,.cjs,.mjs,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs,.jsx,.ts,.tsx --fix",
    "typecheck": "node scripts/bun-check.mjs",
    "test:bun-check": "node --test scripts/bun-check-regression.mjs",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run",
    "audit:dependencies": "bun scripts/dependency-audit.cjs audit",
    "build:pages": "node scripts/build-pages.mjs",
    "llms:full": "bun scripts/generate-llms-full.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1172.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1172.0",
    "@types/node": "24.19.2",
    "chart.js": "4.6.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "postcss": "^8.5.33",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "21.0.4",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  }
}
